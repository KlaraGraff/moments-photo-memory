    "Rename a place, or tick places that are the same and merge them. Places with the same name are one place in the filters and on the map." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benenne einen Ort um oder hake Orte an, die derselbe sind, und führe sie zusammen. Orte mit gleichem Namen sind in Filtern und auf der Karte ein Ort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rename a place, or tick places that are the same and merge them. Places with the same name are one place in the filters and on the map."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以给地点改名；勾选其实是同一处的地点，然后合并。同名的地点在筛选和地图里算作一个地点。"
          }
        }
      }
    },
