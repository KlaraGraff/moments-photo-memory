    "There isn't enough disk space." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht genug Speicherplatz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There isn't enough disk space."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磁盘空间不够。"
          }
        }
      }
    },
    "Your original photos stay where they are; the library keeps memories, people and places. It is backed up every day, and the last 14 days are kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Originalfotos bleiben, wo sie sind; die Mediathek enthält Erinnerungen, Personen und Orte. Sie wird täglich gesichert, die letzten 14 Tage werden aufbewahrt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your original photos stay where they are; the library keeps memories, people and places. It is backed up every day, and the last 14 days are kept."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原图留在原来的位置，资料库里是回忆、人物和地点。每天自动备份，保留最近 14 天。"
          }
        }
      }
    },
