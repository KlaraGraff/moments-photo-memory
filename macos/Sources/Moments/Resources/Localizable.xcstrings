    "Finds the people in new photos and shows what was sorted into trips and places. Turned off, new photos still land in trips; look for people from People when you like." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Findet die Personen auf neuen Fotos und zeigt, was nach Reisen und Orten geordnet wurde. Ausgeschaltet landen neue Fotos trotzdem in Reisen; Personen suchst du dann selbst unter „Personen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finds the people in new photos and shows what was sorted into trips and places. Turned off, new photos still land in trips; look for people from People when you like."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找出新照片里的人，并显示照片被分到了哪些旅行和地点。关闭后新照片仍会按旅行归类，人物可以之后在「人物」里再找。"
          }
        }
      }
    },
    "Library location" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speicherort der Mediathek"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Library location"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照片库位置"
          }
        }
      }
    },
    "Backups" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backups"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backups"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备份"
          }
        }
      }
    },
    "Your original photos stay where they are; the library keeps notes, people and places. Backups are made when the library can't be opened." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Originalfotos bleiben, wo sie sind; die Mediathek speichert Notizen, Personen und Orte. Backups entstehen, wenn die Mediathek nicht geöffnet werden kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your original photos stay where they are; the library keeps notes, people and places. Backups are made when the library can't be opened."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原始照片留在原处，照片库只保存备注、人物和地点。照片库打不开时会自动在这里留一份备份。"
          }
        }
      }
    },
    "Looks for faces in photos that haven't been checked yet. Names you gave stay as they are." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sucht Gesichter in Fotos, die noch nicht geprüft wurden. Vergebene Namen bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Looks for faces in photos that haven't been checked yet. Names you gave stay as they are."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在还没检查过的照片里找人脸。已经起好的名字不会变。"
          }
        }
      }
    },
