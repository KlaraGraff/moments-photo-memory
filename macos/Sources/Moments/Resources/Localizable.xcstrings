    },
    "Write what happened, how it felt, where it was. It is saved as you type. Option-Return starts a new line." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreib, was passiert ist, wie es sich anfühlte, wo es war. Es wird beim Tippen gesichert. Wahl-Return beginnt eine neue Zeile."
          }
        },
