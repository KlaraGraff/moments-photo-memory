// Code signing and identity for the Moments app target.
//
// Committed defaults build unsigned (CI and fresh clones). To sign locally,
// copy Local.xcconfig.example to Local.xcconfig (gitignored) and fill in your
// team; nothing that identifies a developer account is ever committed.
//
// The bundle identifier and the iCloud container are final: both are
// registered with Apple and can never be renamed. Earlier builds used the
// placeholders org.example.Moments and org.example.Moments.peoplepreview;
// AppIdentityMigration.swift carries their settings and library over.

CODE_SIGN_STYLE = Automatic
MOMENTS_BUNDLE_ID = com.momentsphotomemory.Moments
MOMENTS_ICLOUD_CONTAINER = iCloud.com.momentsphotomemory.Moments
// Push environment for CloudKit change notifications. The release script
// passes production when it exports for the production CloudKit environment.
MOMENTS_APS_ENVIRONMENT = development
PRODUCT_BUNDLE_IDENTIFIER = $(MOMENTS_BUNDLE_ID)
CODE_SIGNING_ALLOWED = NO
CODE_SIGNING_REQUIRED = NO
CODE_SIGN_IDENTITY =

#include? "Local.xcconfig"
