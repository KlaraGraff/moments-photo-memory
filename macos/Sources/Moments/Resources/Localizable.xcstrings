    "The originals are on your partner's Mac; here you see smaller previews." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Originale liegen auf dem Mac deines Partners; hier siehst du kleinere Vorschauen."
          }
        },
