    "Moments backs up the library each day it changes and keeps the last 14 backups. Original photos are not in the backup." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moments sichert die Mediathek an jedem Tag, an dem sie sich ändert, und bewahrt die letzten 14 Sicherungen auf. Originalfotos sind nicht in der Sicherung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
