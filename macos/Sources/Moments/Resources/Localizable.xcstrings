    "You can add more from a trip later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weitere kannst du später bei einer Reise hinzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
