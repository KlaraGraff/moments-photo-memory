        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立即扫描"
          }
        }
      }
    },
    "Share your library with your partner, see who is connected and choose which changes notify you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile deine Mediathek mit deinem Partner, sieh, wer verbunden ist, und wähle, welche Änderungen dich benachrichtigen."
          }
        },
