<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CloudKit, for sharing chosen trips between two people. -->
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>$(MOMENTS_ICLOUD_CONTAINER)</string>
	</array>
	<!-- CloudKit pushes changes from the other person through APNs. -->
	<key>com.apple.developer.aps-environment</key>
	<string>$(MOMENTS_APS_ENVIRONMENT)</string>
	<!-- The hardened runtime (required for notarization) blocks Photos
	     access unless the app declares it. The app is not sandboxed. -->
	<key>com.apple.security.personal-information.photos-library</key>
	<true/>
</dict>
</plist>
