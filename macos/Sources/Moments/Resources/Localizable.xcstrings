    "No backups on this Mac yet. To move to a new Mac, choose a backup copied from the old one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Mac gibt es noch keine Sicherung. Für einen neuen Mac wähle eine Sicherung, die du vom alten kopiert hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No backups on this Mac yet. To move to a new Mac, choose a backup copied from the old one."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 上还没有备份。换电脑时，选从旧电脑拷过来的那份备份。"
          }
        }
      }
    },
    "Backups hold memories, trips, places, people and your choices, not the original photos. Before a restore, the current library is saved too." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sicherungen enthalten Erinnerungen, Reisen, Orte, Personen und deine Entscheidungen, nicht die Originalfotos. Vor dem Wiederherstellen wird auch die aktuelle Mediathek gesichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backups hold memories, trips, places, people and your choices, not the original photos. Before a restore, the current library is saved too."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备份里有回忆、旅程、地点、人物和你做过的选择，没有原图。恢复前，现在的资料库也会先另存一份。"
          }
        }
      }
    },
