{
  "sourceLanguage" : "en",
  "strings" : {
    "Your library couldn't be opened" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Mediathek konnte nicht geöffnet werden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your library couldn't be opened"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法打开图库"
          }
        }
      }
    },
    "Moments couldn't open its data, so it saved a copy to %@ and started a new, empty library. Your original photos are not affected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moments konnte seine Daten nicht öffnen, hat eine Kopie unter %@ gesichert und eine neue, leere Mediathek angelegt. Deine Originalfotos sind nicht betroffen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moments couldn't open its data, so it saved a copy to %@ and started a new, empty library. Your original photos are not affected."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moments 无法打开它的数据，已将一份副本保存到 %@，并新建了一个空图库。你的原始照片不受影响。"
          }
        }
      }
    },
