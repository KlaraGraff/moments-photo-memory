    "Rearranges chapters, fills in places, finds bursts and regroups people, one after another." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordnet Kapitel neu, ergänzt Orte, findet Serien und gruppiert Personen neu – nacheinander."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
