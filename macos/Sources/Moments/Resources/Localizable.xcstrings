        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原图在对方的 Mac 上，这里看到的是缩小的预览。"
          }
        }
      }
    },
    "The shared trips disappear from this Mac. What you wrote has already been synced and stays with your partner. To join again, ask for a new invitation." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die geteilten Reisen verschwinden von diesem Mac. Was du geschrieben hast, ist bereits synchronisiert und bleibt bei deinem Partner. Um wieder beizutreten, bitte um eine neue Einladung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The shared trips disappear from this Mac. What you wrote has already been synced and stays with your partner. To join again, ask for a new invitation."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共享的旅程会从这台 Mac 上消失。你写的回忆已经同步给对方，对方那边会保留。要再加入，需要对方重新邀请。"
          }
        }
      }
    },
    "This copy of Moments is not signed for iCloud. Install the signed version to share with your partner." : {
