    },
    "Living somewhere for this many days or more, like a new work site, is daily life, not a trip." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer so viele Tage oder länger an einem Ort lebt, etwa an einem neuen Arbeitsort, hat Alltag, keine Reise."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Living somewhere for this many days or more, like a new work site, is daily life, not a trip."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在一个地方住满这么多天或更久，比如新的工作地，就算日常生活，不算旅行。"
          }
        }
      }
    },
    "This place is" : {
