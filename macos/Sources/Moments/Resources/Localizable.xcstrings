          "stringUnit" : {
            "state" : "translated",
            "value" : "把所有的脸按现在的规则重新分一次组，再重新列出「这两组是同一个人吗？」。"
          }
        }
      }
    },
    "Looks up names for places that have none yet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sucht Namen für Orte, die noch keinen haben."
