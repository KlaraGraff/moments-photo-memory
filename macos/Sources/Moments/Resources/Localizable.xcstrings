    "Memories and changes made after it go back to how they were then. The current library is saved first, so you can restore it again. Moments will reopen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erinnerungen und Änderungen danach werden auf diesen Stand zurückgesetzt. Die aktuelle Mediathek wird vorher gesichert, du kannst sie also wiederherstellen. Moments wird neu geöffnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memories and changes made after it go back to how they were then. The current library is saved first, so you can restore it again. Moments will reopen."
          }
