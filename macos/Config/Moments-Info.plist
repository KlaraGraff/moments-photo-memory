<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the generated Info.plist. Sharing code reads the
	     container from here instead of spelling it out. -->
	<key>MomentsCloudKitContainerIdentifier</key>
	<string>$(MOMENTS_ICLOUD_CONTAINER)</string>
	<!-- Lets the app accept CloudKit share invitations. -->
	<key>CKSharingSupported</key>
	<true/>
</dict>
</plist>
